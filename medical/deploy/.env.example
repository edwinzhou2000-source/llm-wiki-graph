# =====================================================
# adidas Knowledge Hub — 服务端环境变量
# 复制此文件为 .env.production 并填入真实值
# =====================================================

# 运行端口 (默认 8767)
PORT=8767

# 只读模式 — 公网部署必须设为 true
# true: 禁止上传/编辑/审批/执行脚本等所有写操作
READ_ONLY=true

# Q&A 限流 — 每个 IP 每分钟最大请求数 (0=不限)
# nginx 也有独立的限流配置，双层保护
QA_RATE_LIMIT=10

# DeepSeek API Key (必填 — Q&A 和 enricher 共用)
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址 (可选，默认 https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# gbrain 数据库路径 (PGLite)
GBRAIN_HOME=/home/deploy/.gbrain-adidas-v2

# Bun 运行时可执行文件路径
# BUN_PATH=/home/deploy/.bun/bin/bun
