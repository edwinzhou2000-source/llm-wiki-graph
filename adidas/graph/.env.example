# Copy this file to .env (gitignored) and fill local-only values.
# Never commit real passwords.
#
# For docker compose, set NEO4J_AUTH to the Neo4j form: <user>/<password>
# Example shape only — choose your own local password:
#   NEO4J_AUTH=<user>/<password>

NEO4J_AUTH=
ADIDAS_NEO4J_URI=bolt://localhost:7688
ADIDAS_NEO4J_USER=neo4j
ADIDAS_NEO4J_PASSWORD=
